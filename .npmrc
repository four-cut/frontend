# react-native-print@0.11.0 이 react-native-windows 를 peer 로 요구하는데,
# 그게 react-native@0.84 를 물고 와서 우리 0.87 과 충돌한다.
# 이 설정이 없으면 npm install / npm ci 가 ERESOLVE 로 아예 실패한다.
#
# 임시 조치다. react-native-print 는 2023-01 이 마지막 배포라 RN 0.87 New
# Architecture 검증이 안 돼 있다. 유지보수되는 대안(expo-print 등)으로 바꾸거나
# Android PrintHelper 를 감싼 작은 네이티브 모듈로 대체하면 이 줄을 지울 수 있다.
legacy-peer-deps=true
