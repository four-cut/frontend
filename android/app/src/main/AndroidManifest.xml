<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 저장 완료를 손끝으로 알리는 짧은 진동. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- API 29 부터는 scoped storage 라 앨범 저장에 권한이 필요 없다. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 스티커를 앨범에서 골라올 때 사진을 읽어야 한다. API 33부터는 READ_MEDIA_IMAGES. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!--
        화면은 세로로 고정한다. 촬영 화면은 "화면은 세로 고정, 기기만 눕는다" 를
        전제로 가로형 촬영 UI 를 직접 돌려 그린다(CaptureScreen). 화면까지 같이
        돌면 그 계산이 어긋난다. iOS 는 Info.plist 에서 이미 세로 고정이다.

        Android 16(타깃 36)부터 큰 화면(짧은 변 600dp 이상)에서는 방향 고정을
        무시한다. 부스 태블릿에서도 세로를 지키려고 아래 property 로 예외를
        신청한다. 이 예외는 타깃 37 부터 없어지므로, 그 전에 촬영 화면이 화면
        회전을 견디게 바꾸거나 가로 화면을 따로 만들어야 한다.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:screenOrientation="portrait"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <property
          android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
          android:value="true" />
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
      <!--
        카카오 로그인 리다이렉트 수신부.
        카카오톡 앱이나 브라우저가 kakao{앱키}://oauth 로 돌아오면 여기가 받는다.
        Android 12 이상을 타깃으로 하므로 exported 를 명시해야 한다.
      -->
      <activity
        android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.VIEW" />
          <category android:name="android.intent.category.DEFAULT" />
          <category android:name="android.intent.category.BROWSABLE" />
          <data
            android:host="oauth"
            android:scheme="kakao${KAKAO_NATIVE_APP_KEY}" />
        </intent-filter>
      </activity>
      <!--
        캐시에 있는 파일을 다른 앱(인스타그램 등)에 넘기려면 content:// 로
        바꿔 줘야 한다. file:// 를 그대로 던지면 FileUriExposedException 이 난다.
      -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>
